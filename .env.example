# 复制为 .env，并为每项密钥生成不同的随机值（至少 32 位）。不要提交 .env。
APP_ORIGIN=http://127.0.0.1:8001
POEMS_PORT=8001
MYSQL_PASSWORD=replace-with-a-random-password-32-chars
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
REDIS_PASSWORD=replace-with-a-different-redis-password
AUTH_SECRET=replace-with-a-random-secret-at-least-32-chars
ADMIN_USERNAME=admin
# 默认管理员密钥随代码公开；可设置 ADMIN_KEY 覆盖。
ADMIN_KEY=zmhnb
# 本地联调：邮件只进入 Mailpit，不会送到真实收件箱。
COMPOSE_PROFILES=local-mail
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="一笺诗意 <noreply@poems.local>"
# 真实邮件：清空 COMPOSE_PROFILES；填写服务商 SMTP 配置。
# 常见 465：SMTP_SECURE=true；587：SMTP_SECURE=false, SMTP_REQUIRE_TLS=true。
# SMTP_FROM 应使用服务商允许的发件地址。
TRUST_PROXY_HOPS=0
